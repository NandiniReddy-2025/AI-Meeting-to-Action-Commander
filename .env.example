# ==============================================================================
# AI MEETING-TO-ACTION COMMANDER - ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000

# Google Gemini API Key (Optional but recommended for state-of-the-art LLM reasoning)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# YouTube Data API v3 Key (Optional - public captions are extracted automatically)
YOUTUBE_API_KEY=

# Live Meeting Bot Service Configuration (Optional: required only for live Google Meet / Zoom / Teams bots)
# Options: recall_ai | daily | custom
MEETING_BOT_PROVIDER=recall_ai
RECALL_AI_API_KEY=

# Zoom Marketplace Server-to-Server OAuth Credentials (Optional)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# Microsoft Teams Azure Bot Framework Credentials (Optional)
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_TENANT_ID=
